# Copy to .env and fill in. .env is gitignored and is never baked into the Docker image
# (see .dockerignore). On Fly this value is set as a secret instead:
#
#   flyctl secrets set ANTHROPIC_API_KEY=... --app razorpay-design-context
#
# Only the chat panel needs this. The captured library, the atlas, the map, the design
# language and Copy-for-Figma all work with no key at all.
ANTHROPIC_API_KEY=
